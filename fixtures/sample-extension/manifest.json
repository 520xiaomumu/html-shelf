{
  "manifest_version": 3,
  "name": "页架示例扩展",
  "version": "1.0.0",
  "description": "用于验收页架 unpacked 扩展加载。不是商店商品。",
  "action": {
    "default_title": "页架示例扩展",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
